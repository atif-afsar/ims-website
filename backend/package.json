{
  "name": "ims-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API and web server for the Islamic Mission School website",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/cli/migrate.js",
    "create-admin": "node --env-file-if-exists=.env src/cli/create-admin.js",
    "import-supabase": "node --env-file-if-exists=.env src/cli/import-supabase.js",
    "test": "node --test test/*.test.js",
    "backup": "node --env-file-if-exists=.env src/cli/backup.js",
    "restore": "node --env-file-if-exists=.env src/cli/restore.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0"
  }
}
