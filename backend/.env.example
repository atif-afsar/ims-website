# Copy to .env and fill in. On Hostinger, set these in hPanel → Node.js → Environment variables.
NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ims
DB_PASSWORD=
DB_NAME=ims

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional
SESSION_DAYS=7
MAX_UPLOAD_MB=8
# On Hostinger use an absolute folder OUTSIDE the app folder, so redeploying never deletes uploads,
# e.g. UPLOADS_DIR=/home/<your-user>/ims-uploads
UPLOADS_DIR=uploads
FRONTEND_DIST=../frontend/dist
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Production only: the main address; the bare domain (without www) redirects to it
# CANONICAL_HOST=www.islamicmissionschool.org
